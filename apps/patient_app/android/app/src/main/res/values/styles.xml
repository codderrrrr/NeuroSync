<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- NeuroSync opens dark whatever the system is set to: the first-time
         experience is dark-first, so the window behind it has to be dark as
         well. A light LaunchTheme made the launch flash white before the
         splash drew. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Shown while the process starts; removed when the Flutter engine
             draws its first frame. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Applied as soon as the process has started, and kept behind the
         Flutter UI while it runs. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
